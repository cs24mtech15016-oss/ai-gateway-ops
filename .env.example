# Copy to .env and fill in.  ->  cp .env.example .env

# --- LiteLLM proxy ---
# Master admin key. Clients authenticate with this (or virtual keys derived from it).
# Must start with "sk-". Generate: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-change-me
# Used to encrypt stored credentials in the DB. Generate: openssl rand -hex 32
LITELLM_SALT_KEY=change-me

# --- Postgres ---
POSTGRES_PASSWORD=litellm

# Note: models are served by Ollama running natively on this Mac (Metal GPU).
# LiteLLM reaches it at http://host.docker.internal:11434 (set in compose).
# No HF token or cloud API keys are needed for local Ollama models.
